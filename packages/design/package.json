{
  "name": "@herbal/design",
  "version": "0.0.0",
  "private": true,
  "description": "The design system: shared foundations and the looks of the console and the shop (ADR 0036)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./console.css": "./css/console.css",
    "./shop.css": "./css/shop.css",
    "./theme-init": "./src/theme-init.ts",
    "./shop-fonts": "./src/shop-fonts.ts",
    "./text-marks": "./src/text-marks.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "preview:dev": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts && node preview/check-build.ts",
    "preview:serve": "vite preview --config preview/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0"
  }
}
