generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // For the one-default-address rule (ADR 0019).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  fullName        String
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  // Staff MFA (ADR 0013): the TOTP secret, encrypted and bound to this user's
  // ID; when it was set up; the last time step used, so no code works twice.
  mfaSecret       String?
  mfaEnabledAt    DateTime?
  mfaLastUsedStep Int?

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  staffInvitations        StaffInvitation[]
  addresses               Address[]
  cart                    Cart?
  orders                  Order[]

  @@index([role])
  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// An invitation for a new Admin to choose their own password (ADR 0015).
// Only the SHA-256 hash of the link's token is stored, as for reset links.
model StaffInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("staff_invitations")
}


model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

// Append-only: database triggers refuse UPDATE, DELETE and TRUNCATE (ADR 0012).
// No foreign keys on purpose: an entry must outlive the user or row it describes.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now())
  // The staff user who acted, or null for a developer command or the system.
  actorId    String?  @db.Uuid
  // What happened, as "thing.verb", for example "super_user.created".
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  requestId  String?

  @@map("audit_log")
}

// A customer's delivery address (ADR 0019). Indian addresses only for now:
// the launch market is India (docs/requirements.md).
model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  // Who receives the parcel, and the 10-digit mobile number the courier calls.
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // At most one default address per customer, even for two requests at once.
  @@unique([userId], map: "addresses_one_default_per_user", where: { isDefault: true })
  @@map("addresses")
}

// A product category, such as "Hair care" (ADR 0020). One level for now:
// categories do not contain other categories.
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  // The category's part of a web address, such as "hair-care". Unique, so
  // two categories can never share a name that only differs in case.
  slug        String   @unique
  description String?
  // Customers never see an inactive category. A new one starts inactive,
  // so staff can prepare it before it shows.
  isActive    Boolean  @default(false)
  // Customers see the categories in this order, then by name.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products Product[]

  @@map("categories")
}

// What a product is under Indian law. It decides which licence its page
// shows: AYUSH for an Ayurvedic medicine, FSSAI for a food or supplement,
// and a cosmetics licence for a cosmetic.
enum ProductType {
  AYURVEDIC_MEDICINE
  FOOD_OR_SUPPLEMENT
  COSMETIC
}

model Product {
  id                  String       @id @default(uuid()) @db.Uuid
  categoryId          String       @db.Uuid
  name                String
  // The product's part of a web address, such as "ashwagandha-capsules".
  slug                String       @unique
  // One line for list pages. The rest is for the product's own page.
  summary             String?
  description         String?
  // Exactly as printed on the pack.
  ingredients         String?
  usage               String?
  // The licence and maker details its page must show. A draft may lack
  // them, but a product goes live only with all of them and its
  // ingredients: a check constraint in the migration enforces that too.
  type                ProductType?
  licenceNumber       String?
  manufacturerName    String?
  manufacturerAddress String?
  countryOfOrigin     String       @default("India")
  // How the goods are classified for GST, and the GST rate in percent. All
  // pack sizes of the product share them. Needed before it goes live too.
  hsnCode             String?
  gstRate             Int?
  // Customers see a product only while it and its category are active.
  isActive            Boolean      @default(false)
  // The order within its category, then by name.
  position            Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // A category that still has products cannot be deleted.
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@map("products")
}


// The unit of a pack's net quantity, as the label states it.
enum PackUnit {
  G
  KG
  ML
  L
  CAPSULES
  TABLETS
  PIECES
}

// One pack size of a product, such as 60 capsules or 100 g, with its own
// prices. Prices are whole rupees: 499 is Rs 499 (ADR 0022).
model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  // Staff's own code for this pack, such as "ASH-CAP-60". Unique.
  sku         String   @unique
  // The net quantity on the label: 60 and CAPSULES, or 100 and G.
  quantity    Int
  unit        PackUnit
  // The MRP printed on the pack, and the price the shop charges, which is
  // never more: a check constraint in the migration enforces that too.
  mrpRupees   Int
  priceRupees Int
  // A pack can be taken off sale without touching the product.
  isActive    Boolean  @default(true)
  // The order on the product's page.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The pack sizes go with their product when it is deleted.
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches   StockBatch[]
  cartItems CartItem[]

  // A product has each pack size once.
  @@unique([productId, quantity, unit])
  @@map("product_variants")
}

// A photo of a product, stored as two WebP files, a large one and a small
// one for list pages (ADR 0023). A product has at most 6, and a live product
// at least 1: triggers in the migration enforce both too.
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  // The random name of its files. The shop shows this, never the ID.
  fileKey   String   @unique @db.Uuid
  // The large file's size in pixels, so a page can keep room for it.
  width     Int
  height    Int
  // Describes the photo for people who cannot see it. Without one, the
  // shop uses the product's name.
  altText   String?
  // The order on the product's page. The first is the main photo.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The images go with their product when it is deleted.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Why a batch's stock changed (ADR 0024). Orders will add their own reasons.
enum StockReason {
  // A delivery arrived: always more stock.
  RECEIVED
  // Broken, spoiled or lost: always less.
  DAMAGED
  // Written off near or past its expiry: always less.
  EXPIRED
  // A count found a difference: more or less.
  CORRECTION
  // An order took these packs: always less (ADR 0026).
  ORDERED
  // An order that was cancelled or expired gave them back: always more.
  RELEASED
}

// One batch of a pack size, with what its label says: the batch number, the
// manufacturing date and the expiry date (ADR 0024). Its quantity changes
// only through stock movements, which a trigger in the migration applies.
model StockBatch {
  id             String   @id @default(uuid()) @db.Uuid
  variantId      String   @db.Uuid
  // As printed on the pack, such as "AB2611". Unique within the pack size.
  batchNumber    String
  manufacturedOn DateTime @db.Date
  expiresOn      DateTime @db.Date
  // On hand now: the sum of its movements, never below 0.
  quantity       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // The batches go with their pack size, but only once their stock is 0:
  // a trigger in the migration refuses to delete a batch that holds stock.
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([variantId, batchNumber])
  @@index([variantId, expiresOn])
  @@map("stock_batches")
}

// One change to a batch's stock (ADR 0024). Never changed or deleted: a
// mistake is put right by another movement.
model StockMovement {
  id        String      @id @default(uuid()) @db.Uuid
  batchId   String      @db.Uuid
  // More (positive) or less (negative), never 0.
  change    Int
  reason    StockReason
  note      String?
  // The staff member who made it. No foreign key, like the audit log, so
  // the history outlives the account.
  actorId   String?     @db.Uuid
  // The order that took or gave back these packs, for ORDERED and RELEASED
  // only.
  orderId   String?     @db.Uuid
  createdAt DateTime    @default(now())

  // The movements go with their batch.
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// A signed-in customer's cart (ADR 0025): one per customer, made when the
// first pack is added. It holds no prices: it always shows today's. A cart
// not changed for 90 days is deleted.
model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  // The last change to the cart or to its lines.
  updatedAt DateTime @updatedAt

  // The cart goes with its customer.
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
  @@map("carts")
}

// One pack size in a cart, and how many packs of it. A cart holds at most
// 4 packs of one product, all its pack sizes together, and at most 50 pack
// sizes: a trigger in the migration enforces both.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  // How many packs: 1 to 4.
  packs     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The lines go with their cart, and with their pack size.
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Each pack size once per cart.
  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// Where an order stands (ADR 0026). Paying comes in part 8.
enum OrderStatus {
  // Placed, its stock held until holdExpiresAt, waiting for payment.
  PENDING_PAYMENT
  // Paid, and waiting to be packed.
  PAID
  // Cancelled before it shipped: its stock went back, and a payment went
  // back in full.
  CANCELLED
  // Not paid in time: its stock went back.
  EXPIRED
  // Packed by staff, for the courier (ADR 0028).
  PACKED
  // Handed to the courier, with its tracking number.
  SHIPPED
  // Delivered to the customer.
  DELIVERED
}

// A customer's order (ADR 0026). It keeps a copy of everything the customer
// agreed to, the address and the prices included, so later changes to the
// catalog or the address book never change it. Money is in whole rupees,
// like the catalog's, the GST too, rounded to the nearest rupee. Orders are
// never deleted, and what was agreed never changes: triggers in the
// migrations refuse both.
model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  // What the customer quotes, such as "7KQ2M9XDPA": random, so it says
  // nothing about how many orders the shop gets.
  reference            String      @unique
  userId               String      @db.Uuid
  // The customer's Idempotency-Key: the same key places one order.
  idempotencyKey       String      @db.Uuid
  status               OrderStatus @default(PENDING_PAYMENT)
  // A copy of the delivery address as it was (ADR 0019).
  deliveryName         String
  deliveryPhone        String
  deliveryLine1        String
  deliveryLine2        String?
  deliveryCity         String
  deliveryState        String
  deliveryPincode      String
  // The items at their prices, with the GST inside them (prices include
  // GST), the delivery charge, and what the customer pays.
  itemsTotalRupees     Int
  itemsGstRupees       Int
  deliveryChargeRupees Int
  totalRupees          Int
  // An unpaid order holds its stock until then.
  holdExpiresAt        DateTime
  // The steps after payment, each marked by staff (ADR 0028): packed, handed
  // to the courier with its tracking number, and delivered.
  packedAt             DateTime?
  shippedAt            DateTime?
  courierName          String?
  trackingNumber       String?
  deliveredAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // A customer with orders is never deleted.
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  movements StockMovement[]
  // The Razorpay order its customer pays (ADR 0027).
  payment   Payment?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  // For the job that expires unpaid orders.
  @@index([status, holdExpiresAt])
  // For staff: the orders in one status, the oldest first.
  @@index([status, createdAt])
  @@map("orders")
}

// One pack size in an order: a copy of what the customer bought, at that
// moment's price. The pack size's ID has no foreign key, like the audit
// log's actor: the order outlives the catalog.
model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  variantId       String   @db.Uuid
  // The order of the lines, as they were in the cart.
  position        Int
  productName     String
  sku             String
  quantity        Int
  unit            PackUnit
  // For the GST invoice (ADR 0022).
  hsnCode         String
  gstRate         Int
  mrpRupees       Int
  priceRupees     Int
  packs           Int
  // packs times priceRupees, and the GST inside it.
  lineTotalRupees Int
  gstRupees       Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Each pack size once per order.
  @@unique([orderId, variantId])
  @@map("order_items")
}

// What a customer pays an order with, at Razorpay (ADR 0027): one for each
// order, made when the customer first chooses to pay. Money in whole rupees.
model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @unique @db.Uuid
  // Razorpay's order, such as "order_RB58MiP5SPFYyM", for the order's total.
  razorpayOrderId   String    @unique
  amountRupees      Int
  // The Razorpay payment that paid the order, and when, once one has.
  razorpayPaymentId String?   @unique
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // An order is never deleted, and neither is its payment.
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@map("payments")
}

// Why money goes back to a customer.
enum RefundReason {
  // Paid after the order expired, when its stock had gone (the owner's rule).
  ORDER_EXPIRED
  // Paid for an order the customer had cancelled.
  ORDER_CANCELLED
  // A second payment for an order that was already paid.
  ALREADY_PAID
  // A paid order the customer cancelled before it shipped (ADR 0028).
  CANCELLED_BY_CUSTOMER
  // A paid order a Super User cancelled before it shipped (ADR 0028).
  CANCELLED_BY_STAFF
}

enum RefundStatus {
  // Saved, but Razorpay has not taken it yet: the refund job asks again.
  REQUESTED
  // Razorpay has taken it, and the money is on its way back.
  PENDING
  // The money is back with the customer.
  PROCESSED
  // Razorpay could not give it back: staff must act.
  FAILED
}

// Money given back to a customer, always a whole Razorpay payment (ADR 0027).
model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  // The Razorpay payment given back: each at most once.
  razorpayPaymentId String       @unique
  amountRupees      Int
  reason            RefundReason
  status            RefundStatus @default(REQUESTED)
  // Razorpay's refund, such as "rfnd_FP8QHiV938haTz", once it has taken it.
  razorpayRefundId  String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Never deleted either.
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  // For the job that asks Razorpay again.
  @@index([status, createdAt])
  @@map("refunds")
}
