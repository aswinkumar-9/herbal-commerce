{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.ts",
    "build": "react-router typegen && tsc --noEmit && react-router build && node scripts/check-build.ts",
    "start": "node server.ts --production",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint app/ server/",
    "test": "vitest run",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@herbal/design": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@react-router/express": "8.5.1",
    "@react-router/node": "8.5.1",
    "express": "5.2.1",
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
