{
  "name": "herbal-commerce",
  "private": true,
  "engines": { "node": ">=24" },
  "scripts": {
    "api:dev": "pnpm --filter api start:dev",
    "api:test": "pnpm --filter api test",
    "api:lint": "pnpm --filter api lint",
    "api:typecheck": "pnpm --filter api typecheck",
    "api:build": "pnpm --filter api build",
    "api:create-super-user": "pnpm --filter api build && pnpm --filter api cli:create-super-user",
    "api:setup-staff-mfa": "pnpm --filter api build && pnpm --filter api cli:setup-staff-mfa",
    "api:limits:clear": "node apps/api/scripts/clear-rate-limits.cjs",
    "api:smoke": "node apps/api/scripts/clear-rate-limits.cjs && node apps/api/scripts/auth-smoke.cjs",
    "api:pay-test": "node apps/api/scripts/pay-test.cjs",
    "admin:dev": "pnpm --filter admin dev",
    "admin:build": "pnpm --filter admin build",
    "admin:preview": "pnpm --filter admin preview",
    "admin:test": "pnpm --filter admin test",
    "admin:lint": "pnpm --filter admin lint",
    "admin:typecheck": "pnpm --filter admin typecheck"
  }
}
