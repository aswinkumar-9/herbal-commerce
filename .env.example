POSTGRES_USER=herbal_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=herbal_dev
POSTGRES_PORT=5432

VALKEY_PASSWORD=change_me_locally
VALKEY_PORT=6379


# API
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://herbal_app:change_me_locally@localhost:5432/herbal_dev
VALKEY_URL=redis://:change_me_locally@localhost:6379
# Proxies allowed to report the client IP, comma separated, for example
# TRUST_PROXY=loopback behind a reverse proxy on the same machine.
# Leave empty unless such a proxy exists: then nobody can fake their IP.
TRUST_PROXY=

#SMTP and WEB_BASE_URL
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Herbal Commerce <no-reply@herbal.local>"
WEB_BASE_URL=http://localhost:3001
# Product images (ADR 0023): the folder they are kept in (inside apps/api)
# and the address the shop links them from. https in production.
MEDIA_DIR=storage/media
MEDIA_BASE_URL=http://127.0.0.1:3000/media

# Secret for signing access tokens, at least 43 characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me

# Encrypts staff MFA secrets in the database. At least 43 characters, and
# different from JWT_ACCESS_SECRET. Generate it with the same command as above.
MFA_ENCRYPTION_KEY=change_me

# Online payments through Razorpay (ADR 0027). From the Razorpay dashboard,
# Account & Settings > API Keys: the Key Id (rzp_test_... in test mode) and
# its Key Secret, which is shown only once. Production needs a live key.
RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change_me
# Our own secret, which Razorpay signs its webhooks with. Generate it with the
# command above, and set the same value in the dashboard with the webhook.
RAZORPAY_WEBHOOK_SECRET=change_me
